# =============================================================================
# Wordsmith Environment Configuration
# =============================================================================

PORT=3001
HOST=0.0.0.0

# 1. LLM API Key (OpenAI / Anthropic / Gemini)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# 2. World Labs API (Entornos 3D)
WORLD_LABS_API_KEY=
WORLD_LABS_BASE_URL=https://api.worldlabs.ai
WORLD_LABS_POLL_INTERVAL_MS=3000   # Cada cuántos ms consultar estado (default: 3000ms)
WORLD_LABS_MAX_RETRIES=40          # Intentos máximos (40 * 3s = 120s timeout)

# 3. Tripo 3D API (Assets GLB)
TRIPO_API_KEY=
TRIPO_BASE_URL=https://api.tripo3d.ai/v2/openapi
TRIPO_POLL_INTERVAL_MS=2500        # Cada cuántos ms consultar estado (default: 2500ms)
TRIPO_MAX_RETRIES=60               # Intentos máximos (60 * 2.5s = 150s timeout)
